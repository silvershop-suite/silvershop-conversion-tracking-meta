{
    "name": "silvershop-suite/conversion-tracking-meta",
    "description": "Meta (Facebook / Instagram) connector for silvershop-suite/conversion-tracking: the Meta Pixel (fbq) client events plus the Conversions API (CAPI) server-side send for Purchase, with shared event_id deduplication, SHA-256 Advanced Matching and fbp/fbc forwarding, all consent-gated.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "conversion-tracking", "meta", "facebook", "pixel", "capi"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl",
            "role": "Lead developer"
        },
        {
            "name": "SilverShop-Suite Contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silvershop-suite/conversion-tracking": "^1.0",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/silvershop-suite/silvershop-conversion-tracking.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\ConversionTracking\\Meta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\ConversionTracking\\Meta\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
